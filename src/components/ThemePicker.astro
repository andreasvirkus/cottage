<div>
  <span class="theme-picker-title">themes (or make your own!)</span>
  <div data-theme-picker class="theme-picker-palette">
    <button style="--theme-bg: var(--theme-light)" data-theme="light" class="light-base"></button>
    <button style="--theme-bg: var(--theme-light-2)" data-theme="light-2" class="light-base"></button>

    <button style="--theme-bg: var(--theme-dark)" data-theme="dark" class="dark-base"></button>
    <button style="--theme-bg: var(--theme-dark-2)" data-theme="dark-2" class="dark-base"></button>
    <button style="--theme-bg: var(--theme-dark-3)" data-theme="dark-3" class="dark-base"></button>

    <a href="/theme-builder" class="theme-picker-custom" data-sound="mouseClick" title="Mix your own theme">+</a>
  </div>
</div>

<script>
  import { playSound } from '../utils/play-sound.ts'

  const picker = document.querySelector('[data-theme-picker]')
  const themeBtn = picker?.querySelectorAll('button') || []
  let prevCursorColor: string

  themeBtn.forEach((btn) => {
    btn.addEventListener('click', () => {
      const theme = btn.dataset.theme || ''
      document.documentElement.setAttribute('data-theme', theme)
      localStorage.setItem('_cottageTheme', theme)
      playSound('themeSwitch')
    })

    btn.addEventListener('mouseenter', (event) => {
      if (event.target === null || !(event.target instanceof HTMLElement)) return

      prevCursorColor = getComputedStyle(document.body).getPropertyValue('--cursor-color')
      const btnTheme = getComputedStyle(event.target).getPropertyValue('--theme-bg')
      document.documentElement.style.setProperty('--cursor-color', btnTheme)
    })

    btn.addEventListener('mouseleave', () => {
      document.documentElement.style.setProperty('--cursor-color', prevCursorColor)
    })

    btn.addEventListener('click', (event) => {
      if (event.target === null || !(event.target instanceof HTMLElement)) return
      const btnTheme = (prevCursorColor = getComputedStyle(event.target).getPropertyValue('--theme-bg'))
      document.documentElement.style.setProperty('--cursor-color', btnTheme)
    })
  })
</script>

<style>
  .theme-picker-title {
    display: block;
    margin-top: 2rem;
    margin-left: -1.45rem;
    font-size: 1rem;
    letter-spacing: 1px;
  }

  .theme-picker-palette {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .theme-picker-separator {
    display: inline-block;
    width: 2px;
    margin: 0;
    margin-right: 2px;
  }

  button {
    all: unset;
    cursor: var(--cursor-pointer), pointer;
    border: 4px transparent;
    height: 0.8rem;
    width: 1.25rem;
    background-color: var(--theme-bg);
    transition:
      box-shadow 0.2s ease-out,
      border-radius 0.2s ease-out;

    &:hover,
    &:focus {
      box-shadow: 0 0 0 0.2rem var(--theme-bg);
      outline: 5px solid var(--theme-bg);
      background-color: transparent;
    }
  }

  .light-base {
    outline: 3px solid var(--theme-bg);
    border: 1px solid white;
    border-bottom: 8px solid white;
  }

  .dark-base {
    border: 1px solid black;
    border-bottom: 8px solid black;
    outline: 3px solid var(--theme-bg);
  }

  .theme-picker-custom {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1.25rem;
    width: 1.25rem;
    border: none;
    border-radius: 50%;
    outline: 1px dashed var(--text-color);
    font-size: 0.85rem;
    line-height: 1;
    color: var(--text-color);
    box-shadow: none;
    transition:
      box-shadow 0.2s ease-out,
      outline-color 0.2s ease-out;

    &:hover,
    &:focus {
      box-shadow: 0 0 0 0.2rem var(--link-color);
      outline-color: var(--link-color);
      background-color: transparent;
    }
  }
</style>
